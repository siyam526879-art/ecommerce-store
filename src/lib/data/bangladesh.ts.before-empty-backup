// Helper: get districts for a division
export function getDistrictsByDivision(divisionId: string): District[] {
  return districts.filter((d) => d.division === divisionId);
}

// Helper: get division by id
export function getDivision(divisionId: string): Division | undefined {
  return divisions.find((d) => d.id === divisionId);
}

// Helper: get district by id
export function getDistrict(districtId: string): District | undefined {
  return districts.find((d) => d.id === districtId);
}